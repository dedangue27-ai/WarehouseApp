<Window x:Class="WarehouseApp.Calcul_des_intérêts__bénéfice_net_"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:local="clr-namespace:WarehouseApp"
        mc:Ignorable="d"
        Title="Calcul des intérêts (Bénéfice net)" Height="650" Width="950"
        WindowStartupLocation="CenterScreen" FlowDirection="LeftToRight">

    <Grid Background="#F8FAFC" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Cartes de résumé (Journalier, Mensuel, Annuel) -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,5,0">
                <StackPanel>
                    <TextBlock Text="Intérêt Journalier" FontSize="12" Foreground="#64748B" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtDailyInterest" Text="0.00 DA" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="Intérêt Mensuel" FontSize="12" Foreground="#64748B" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtMonthlyInterest" Text="0.00 DA" FontSize="18" FontWeight="Bold" Foreground="#3B82F6" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="15" Margin="5,0,0,0">
                <StackPanel>
                    <TextBlock Text="Intérêt Annuel" FontSize="12" Foreground="#64748B" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtYearlyInterest" Text="0.00 DA" FontSize="18" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Outils de filtrage et d'exportation -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,15">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Du date:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                <DatePicker x:Name="DpStartDate" Width="130" Margin="0,0,15,0"/>

                <TextBlock Text="Au date:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                <DatePicker x:Name="DpEndDate" Width="130" Margin="0,0,15,0"/>

                <Button Content="Afficher" Click="BtnFilter_Click" Background="#3B82F6" Foreground="White" Width="90" Height="30" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"/>

                <Button Content="Exporter CSV 📊" Click="BtnExportExcel_Click" Background="#10B981" Foreground="White" Width="130" Height="30" BorderThickness="0" Cursor="Hand"/>
            </WrapPanel>
        </Border>

        <!-- 3. Graphique -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15">
            <Grid>
                <lvc:CartesianChart x:Name="ProfitChart" Hoverable="True">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Title="Jours" Labels="{Binding ChartLabels}"/>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis Title="Bénéfice Net (DA)"/>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>
            </Grid>
        </Border>
    </Grid>
</Window>