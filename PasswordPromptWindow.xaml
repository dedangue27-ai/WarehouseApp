<Window x:Name="PasswordWin" x:Class="WarehouseApp.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تأكيد كلمة المرور" Height="200" Width="350" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FlowDirection="RightToLeft">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="يرجى إدخال كلمة المرور للتأكيد:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
            <PasswordBox x:Name="TxtPasswordBox" Height="30" FontSize="14" Margin="0,0,0,10"/>
            <Button Content="تأكيد" Click="BtnConfirm_Click" Height="35" Background="#007ACC" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>