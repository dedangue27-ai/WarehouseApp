<Window x:Class="WarehouseApp.DevAuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔐 Outil Développeur - Audit des identifiants" Height="450" Width="600"
        WindowStartupLocation="CenterScreen" FlowDirection="LeftToRight"
        Background="#F8FAFC" FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Journal des identifiants du système (Mode DEV)" FontSize="20" FontWeight="Bold" Foreground="#1E3A8A"/>
            <TextBlock Text="Double-cliquez sur un utilisateur pour le supprimer." FontSize="13" Foreground="#64748B" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- جدول عرض البيانات مع حدث النقر المزدوج -->
        <DataGrid x:Name="AuditGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="White" BorderThickness="1" BorderBrush="#E2E8F0"
                  RowHeight="40" FontSize="13" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E2E8F0"
                  MouseDoubleClick="AuditGrid_MouseDoubleClick">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1E3A8A"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,8"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Nom d'utilisateur" Binding="{Binding Username}" Width="160"/>
                <DataGridTextColumn Header="Mot de passe" Binding="{Binding Password}" Width="160"/>
                <DataGridTextColumn Header="Rôle" Binding="{Binding Role}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Fermer" Width="100" Height="38" HorizontalAlignment="Right"
                Background="#3B82F6" Foreground="White" FontWeight="Bold" Cursor="Hand"
                Click="CloseButton_Click" Margin="0,15,0,0"/>
    </Grid>
</Window>