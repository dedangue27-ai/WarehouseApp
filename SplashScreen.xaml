<Window x:Class="WarehouseApp.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" 
        Background="Transparent" WindowStartupLocation="CenterScreen"
        Height="400" Width="600">
    <Border Background="#0F172A" CornerRadius="20" Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📦" FontSize="80" Foreground="#3B82F6" HorizontalAlignment="Center"/>
                <TextBlock Text="Warehouse Pro" FontSize="32" FontWeight="Bold" 
                           Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                <TextBlock Text="Système de gestion des stocks et des ventes" FontSize="16" 
                           Foreground="#64748B" HorizontalAlignment="Center"/>
            </StackPanel>

            <ProgressBar Grid.Row="2" Height="6" HorizontalAlignment="Center" Width="300"
                         Foreground="#3B82F6" Background="#1E293B" 
                         IsIndeterminate="True" Margin="0,20,0,20"/>

            <TextBlock Grid.Row="3" Text="Chargement du système en cours..." Foreground="#64748B" 
                       FontSize="12" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>