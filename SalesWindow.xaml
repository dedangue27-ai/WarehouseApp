<Window x:Class="WarehouseApp.SalesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SalesTitleKey}" 
        MinHeight="700" MinWidth="1100"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen" 
        FlowDirection="{DynamicResource MainFlowDirection}"
        Background="#EBF2FA" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- 3D Blue Button Style -->
        <Style x:Key="Btn3DPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#2563EB" Offset="0.0"/>
                                    <GradientStop Color="#1D4ED8" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#1E40AF" BlurRadius="8" ShadowDepth="4" Direction="270" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3D Success Green Button -->
        <Style x:Key="Btn3DSuccess" TargetType="Button" BasedOn="{StaticResource Btn3DPrimary}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#10B981" Offset="0.0"/>
                                    <GradientStop Color="#059669" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#065F46" BlurRadius="8" ShadowDepth="4" Direction="270" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Action Buttons Style -->
        <Style x:Key="BtnMini" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="TextBox3D" TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="2" Direction="270" Opacity="0.1"/>
                            </Border.Effect>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" Margin="5,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Section Gauche: Recherche et Liste de la facture -->
        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barcode / Recherche -->
            <Border Grid.Row="0" Background="White" CornerRadius="16" Padding="15" Margin="0,0,0,15">
                <Border.Effect>
                    <DropShadowEffect Color="#94A3B8" BlurRadius="15" ShadowDepth="4" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Boutons Navigation (Retour + Logout) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Bottom">
                        <!-- Bouton Retour -->
                        <Button x:Name="BtnBackToMain" 
                                Width="42" Height="40" Margin="0,0,6,0"
                                Click="BtnBackToMain_Click" Foreground="White"
                                FontSize="18" FontWeight="Bold" Cursor="Hand" ToolTip="Retour au menu" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#2563EB"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <TextBlock Text="←" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Bouton Logout -->
                        <Button x:Name="BtnLogout" 
                                Width="42" Height="40" Margin="0,0,6,0"
                                Click="BtnLogout_Click" Foreground="White"
                                FontSize="16" FontWeight="Bold" Cursor="Hand" ToolTip="Déconnexion" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#EF4444"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <TextBlock Text="🚪" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="{DynamicResource SearchPromptKey}" FontSize="13" Foreground="#1E3A8A" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <Grid>
                            <TextBox x:Name="TxtSearchInput" Style="{StaticResource TextBox3D}" PreviewKeyDown="TxtSearchInput_PreviewKeyDown" TextChanged="TxtSearchInput_TextChanged"/>

                            <!-- Popup Suggestions -->
                            <Popup x:Name="PopupSuggestions" PlacementTarget="{Binding ElementName=TxtSearchInput}" Placement="Bottom" StaysOpen="False" Width="{Binding ElementName=TxtSearchInput, Path=ActualWidth}">
                                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000" BlurRadius="8" ShadowDepth="4" Opacity="0.15"/>
                                    </Border.Effect>
                                    <ListBox x:Name="LstSuggestions" MaxHeight="220" BorderThickness="0" FontSize="14" KeyDown="LstSuggestions_KeyDown" MouseDoubleClick="LstSuggestions_MouseDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding [Name]}" FontWeight="Bold" Foreground="#1E293B"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding [Code]}" Foreground="#64748B" Margin="10,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding [Quantity], StringFormat={}{0}}" Foreground="#D97706" FontWeight="SemiBold" Margin="10,0"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding [SellingPrice], StringFormat={}{0:N2}}" Foreground="#10B981" FontWeight="Bold"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>

                    <Button Grid.Column="2" x:Name="BtnAddProduct" Content="{DynamicResource AddToCartKey}" Style="{StaticResource Btn3DPrimary}" VerticalAlignment="Bottom" Click="BtnAddProduct_Click"/>
                </Grid>
            </Border>

            <!-- Table des Articles -->
            <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#94A3B8" BlurRadius="15" ShadowDepth="4" Opacity="0.2"/>
                </Border.Effect>
                <DataGrid x:Name="SalesDataGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0" RowHeight="45" FontSize="14"
                          CellEditEnding="SalesDataGrid_CellEditEnding">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#EFF6FF"/>
                            <Setter Property="Foreground" Value="#1E3A8A"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,8"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource BarcodeColumnKey}" Binding="{Binding Barcode}" Width="130" IsReadOnly="True"/>
                        <DataGridTextColumn Header="{DynamicResource ProductNameColumnKey}" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>

                        <DataGridTemplateColumn Header="{DynamicResource AvailableColumnKey}" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StockQuantity}" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="{DynamicResource PriceColumnKey}" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="90" IsReadOnly="True"/>

                        <DataGridTemplateColumn Header="{DynamicResource RequestedQtyColumnKey}" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="-" Style="{StaticResource BtnMini}" Click="BtnDecreaseQty_Click" Tag="{Binding}"/>
                                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="45" TextAlignment="Center" Margin="5,0" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                                        <Button Content="+" Style="{StaticResource BtnMini}" Click="BtnIncreaseQty_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="{DynamicResource TotalColumnKey}" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="110" IsReadOnly="True"/>

                        <DataGridTemplateColumn Header="{DynamicResource ActionColumnKey}" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑️" Foreground="#EF4444" Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand" Click="BtnRemoveItem_Click" Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Section Droite: Résumé et Validation -->
        <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#94A3B8" BlurRadius="20" ShadowDepth="6" Opacity="0.25"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource InvoiceDetailsKey}" FontSize="20" FontWeight="Bold" Foreground="#1E3A8A" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel VerticalAlignment="Center">
                        <!-- Sous-total -->
                        <Border Background="#F8FAFC" CornerRadius="12" Padding="15" Margin="0,0,0,10">
                            <Grid>
                                <TextBlock Text="{DynamicResource SubTotalKey}" Foreground="#64748B" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TxtSubTotal" Text="0.00" Foreground="#1E293B" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Remise -->
                        <Border Background="#F8FAFC" CornerRadius="12" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource DiscountKey}" Foreground="#64748B" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDiscountInput" Grid.Column="0" Style="{StaticResource TextBox3D}" Text="0" TextChanged="TxtDiscountInput_TextChanged"/>
                                    <ComboBox x:Name="CmbDiscountType" Grid.Column="1" Width="70" Margin="5,0,0,0" FontSize="14" VerticalContentAlignment="Center" SelectionChanged="CmbDiscountType_SelectionChanged">
                                        <ComboBoxItem Content="DA" IsSelected="True"/>
                                        <ComboBoxItem Content="%"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Total Général -->
                        <Border Background="#EFF6FF" CornerRadius="12" Padding="15" Margin="0,0,0,15">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource GrandTotalKey}" Foreground="#1E3A8A" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtGrandTotal" Text="0.00" Foreground="#2563EB" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Bouton Retour Produit -->
                        <Button x:Name="BtnReturnProduct" Content="🔄 Retour" 
                                Background="#EF4444" Foreground="White" FontSize="15" FontWeight="Bold"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Padding="12" BorderThickness="0" Cursor="Hand"
                                Click="BtnReturnProduct_Click" Margin="0,0,0,10">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#DC2626" BlurRadius="6" ShadowDepth="3" Direction="270" Opacity="0.3"/>
                                        </Border.Effect>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="BtnOpenSalesHistory" Content="📊 Historique des Ventes" Style="{StaticResource Btn3DPrimary}" Background="#4F46E5" Click="BtnOpenSalesHistory_Click" Margin="0,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Actions Principales -->
                <StackPanel Grid.Row="2">
                    <Button x:Name="BtnClearCart" Content="{DynamicResource CancelInvoiceKey}" Style="{StaticResource Btn3DPrimary}" Background="#000000" Click="BtnClearCart_Click" Margin="0,0,0,8"/>
                    <Button x:Name="BtnCompleteSale" Content="{DynamicResource CompleteSaleKey}" Style="{StaticResource Btn3DSuccess}" Height="45" Click="BtnCompleteSale_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>