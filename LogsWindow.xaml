<Window x:Class="WarehouseApp.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource LogsTitleKey}" Height="550" Width="800"
        WindowStartupLocation="CenterScreen" FlowDirection="{DynamicResource MainFlowDirection}"
        Background="#F8FAFC" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="Card3D" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#94A3B8" BlurRadius="20" ShadowDepth="6" 
                                     Direction="270" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource Card3D}" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="1" Text="{DynamicResource LogsTitleKey}" FontSize="24" FontWeight="Bold" 
                       Foreground="#1E3A8A" Margin="0,0,0,359"/>

            <DataGrid x:Name="LogsDataGrid" AutoGenerateColumns="False" 
                      IsReadOnly="True" Background="Transparent" BorderThickness="0"
                      RowHeight="40" FontSize="13" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0" Margin="0,45,0,10" Grid.RowSpan="2">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#EFF6FF"/>
                        <Setter Property="Foreground" Value="#1E3A8A"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,8"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource IdColumnKey}" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="{DynamicResource UsernameLabelKey}" Binding="{Binding Username}" Width="150"/>
                    <DataGridTextColumn Header="{DynamicResource ActivityLogsKey}" Binding="{Binding Action}" Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource ActionColumnKey}" Binding="{Binding LogDate}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Window>