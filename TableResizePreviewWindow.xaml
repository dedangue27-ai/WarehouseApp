<Window x:Class="WarehouseApp.TableResizePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modification et aperçu du tableau d'inventaire avant impression" Height="450" Width="600" WindowStartupLocation="CenterScreen" FlowDirection="LeftToRight">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Modifiez la largeur des colonnes en faisant glisser leurs bords avec la souris, puis cliquez sur Imprimer :" 
                   FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid x:Name="PreviewDataGrid" Grid.Row="1" AutoGenerateColumns="False" 
                  CanUserResizeColumns="True" CanUserReorderColumns="False" 
                  IsReadOnly="True" BorderBrush="Black" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sélection" Binding="{Binding Selection}" Width="80"/>
                <DataGridTextColumn Header="Code-barres" Binding="{Binding Code}" Width="120"/>
                <DataGridTextColumn Header="Nom du produit" Binding="{Binding Name}" Width="220"/>
                <DataGridTextColumn Header="Quantité" Binding="{Binding Quantity}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button x:Name="BtnPrintNow" Content="Imprimer le rapport" Grid.Row="2" 
                Background="#10B981" Foreground="White" FontWeight="Bold" 
                Height="40" Margin="0,15,0,0" Click="BtnPrintNow_Click"/>
    </Grid>
</Window>