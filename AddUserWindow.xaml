<Window x:Class="WarehouseApp.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AddUserTitleKey}" Height="540" Width="420"
        WindowStartupLocation="CenterScreen" FlowDirection="{DynamicResource MainFlowDirection}"
        Background="#F8FAFC" FontFamily="Segoe UI">
    <Window.Resources>
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Btn3DPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="12" Padding="20,12"
                                Background="{StaticResource PrimaryGradient}">
                            <Border.Effect>
                                <DropShadowEffect Color="#1E40AF" BlurRadius="12" ShadowDepth="5" 
                                                 Direction="270" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#1E40AF" BlurRadius="18" ShadowDepth="8" 
                                                         Direction="270" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- نمط TextBox مستقل -->
        <Style x:Key="TextBox3D" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="3" 
                                                 Direction="270" Opacity="0.08"/>
                            </Border.Effect>
                            <Grid>
                                <Border x:Name="focusBorder" CornerRadius="10" BorderThickness="2" 
                                        BorderBrush="Transparent"/>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" Margin="5,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="focusBorder" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- نمط PasswordBox مستقل -->
        <Style x:Key="PasswordBox3D" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="3" 
                                                 Direction="270" Opacity="0.08"/>
                            </Border.Effect>
                            <Grid>
                                <Border x:Name="focusBorder" CornerRadius="10" BorderThickness="2" 
                                        BorderBrush="Transparent"/>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" Margin="5,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="focusBorder" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="16" Margin="20">
        <Border.Effect>
            <DropShadowEffect Color="#94A3B8" BlurRadius="20" ShadowDepth="6" 
                             Direction="270" Opacity="0.15"/>
        </Border.Effect>
        <StackPanel Margin="30" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource AddUserTitleKey}" FontSize="22" FontWeight="Bold" 
                       Foreground="#1E3A8A" Margin="0,0,0,25" HorizontalAlignment="Center"/>

            <TextBlock Text="{DynamicResource UsernameLabelKey}" FontWeight="SemiBold" Foreground="#475569" 
                       Margin="0,0,0,5"/>
            <TextBox x:Name="TxtNewUser" Style="{StaticResource TextBox3D}" Margin="0,0,0,15"/>

            <TextBlock Text="{DynamicResource PasswordLabelKey}" FontWeight="SemiBold" Foreground="#475569" 
                       Margin="0,0,0,5"/>
            <PasswordBox x:Name="TxtNewPassword" Style="{StaticResource PasswordBox3D}" Margin="0,0,0,15"/>

            <TextBlock Text="{DynamicResource RoleLabelKey}" FontWeight="SemiBold" Foreground="#475569" 
                       Margin="0,0,0,5"/>
            <ComboBox x:Name="RoleComboBox" Height="40" FontSize="14" Margin="0,0,0,25" SelectedIndex="1">
                <ComboBoxItem Content="{DynamicResource AdminRoleKey}" Tag="Admin"/>
                <ComboBoxItem Content="{DynamicResource SellerRoleKey}" Tag="Seller"/>
            </ComboBox>

            <Button Content="{DynamicResource SaveUserKey}" Style="{StaticResource Btn3DPrimary}" 
                    Click="BtnSaveUser_Click"/>
        </StackPanel>
    </Border>
</Window>