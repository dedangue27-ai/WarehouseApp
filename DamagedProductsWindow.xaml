<Window x:Class="WarehouseApp.DamagedProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des Produits Endommagés (Panier)" Height="650" Width="950"
        WindowStartupLocation="CenterScreen" FlowDirection="LeftToRight"
        Background="#F8FAFC" FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان الرئيسي -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="🗑️ Panier des Produits Endommagés &amp; Périmés" FontSize="22" FontWeight="Bold" Foreground="#1E3A8A"/>
            <TextBlock Text="Enregistrez les produits cassés ou périmés (conservés dans l'historique pendant 1 an)" FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- شريط الإضافة السريعة مع البحث التلقائي والقائمة المنسدلة للأسباب -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <!-- حقل البحث مع القائمة المنبثقة للاقتراحات -->
                <StackPanel Grid.Column="0" Margin="0">
                    <TextBox x:Name="TxtSearchProduct" Height="38" FontSize="14" Padding="10,6" 
                             BorderBrush="#CBD5E1" Background="#F1F5F9" VerticalContentAlignment="Center"
                             ToolTip="Entrez le Code-barres ou le Nom du produit" 
                             TextChanged="TxtSearchProduct_TextChanged" KeyDown="TxtSearchProduct_KeyDown"/>

                    <Popup x:Name="SuggestionsPopup" IsOpen="False" PlacementTarget="{Binding ElementName=TxtSearchProduct}" StaysOpen="False" Width="300">
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" MaxHeight="150">
                            <ListBox x:Name="SuggestionsList" SelectionChanged="SuggestionsList_SelectionChanged" BorderThickness="0" Cursor="Hand"/>
                        </Border>
                    </Popup>
                </StackPanel>

                <TextBox x:Name="TxtDamageQty" Grid.Column="1" Height="38" FontSize="14" Padding="10,6" 
                         BorderBrush="#CBD5E1" Background="#F1F5F9" Text="1" TextAlignment="Center" 
                         VerticalContentAlignment="Center" Margin="10,0,0,0" ToolTip="Quantité"/>

                <!-- قائمة منسدلة لاختيار السبب (Cassé أو Périmé) -->
                <ComboBox x:Name="CmbDamageReason" Grid.Column="2" Height="38" FontSize="14" 
                          VerticalContentAlignment="Center" Margin="10,0,0,0" Background="#F1F5F9" SelectedIndex="0">
                    <ComboBoxItem Content="Cassé"/>
                    <ComboBoxItem Content="Périmé"/>
                </ComboBox>

                <Button Grid.Column="3" Content="+ Ajouter (Panier)" Click="BtnAddToDamageCart_Click" 
                        Background="#EF4444" Foreground="White" Height="38" Margin="10,0,0,0" 
                        Cursor="Hand" FontSize="13" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- جدول المنتجات التالفة -->
        <DataGrid x:Name="DamagedGrid" Grid.Row="2" AutoGenerateColumns="False" 
                  CanUserAddRows="False" IsReadOnly="True"
                  Background="Transparent" BorderThickness="0" 
                  RowHeight="42" FontSize="13" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E2E8F0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Code-barres" Binding="{Binding ProductCode}" Width="120"/>
                <DataGridTextColumn Header="Nom du produit" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Qté" Binding="{Binding Quantity}" Width="70"/>
                <DataGridTextColumn Header="Prix d'Achat (Unit.)" Binding="{Binding PurchasePrice, StringFormat={}{0:N2} DA}" Width="130"/>
                <DataGridTextColumn Header="Total Achat (Perte)" Binding="{Binding TotalPurchasePrice, StringFormat={}{0:N2} DA}" Width="140"/>
                <DataGridTextColumn Header="Raison" Binding="{Binding Reason}" Width="130"/>
                <DataGridTextColumn Header="Date d'enregistrement" Binding="{Binding DamageDate}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- شريط المجموع في الأسفل وأزرار التحكم -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" HorizontalAlignment="Left" Width="300">
                <StackPanel>
                    <TextBlock Text="Total des pertes (Prix d'achat)" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtTotalDamagePurchase" FontSize="20" FontWeight="Bold" Foreground="#EF4444" Margin="0,3,0,0">
                        0.00 DA
                    </TextBlock>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Supprimer l'élément sélectionné" Click="BtnDeleteSelectedDamage_Click" 
                        Background="#64748B" Foreground="White" Height="40" Padding="15,0" Margin="0,0,10,0" 
                        Cursor="Hand" FontWeight="Bold"/>
                <Button Content="Fermer" Click="BtnClose_Click" 
                        Background="#334155" Foreground="White" Height="40" Width="100" 
                        Cursor="Hand" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>