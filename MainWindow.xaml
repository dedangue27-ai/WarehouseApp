<Window x:Class="WarehouseApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}" Height="780" Width="1250"
        WindowStartupLocation="CenterScreen" FlowDirection="LeftToRight"
        Background="#F8FAFC" FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barre latérale -->
        <Border Grid.Column="0" Background="#0F172A" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- En-tête de la barre latérale et sélection de la langue -->
                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Border Background="#3B82F6" Width="45" Height="45" CornerRadius="8">
                            <TextBlock Text="📦" FontSize="22" HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource AppTitle}" FontSize="16" FontWeight="Bold" 
                                       Foreground="White" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Menu de sélection de la langue -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="{DynamicResource LanguageLabelKey}" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
                        <ComboBox x:Name="LanguageSelector" SelectionChanged="LanguageSelector_SelectionChanged" Height="32" Background="#1E293B" Foreground="Black">
                            <ComboBoxItem Content="العربية" Tag="ar"/>
                            <ComboBoxItem Content="Français" Tag="fr" IsSelected="True"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                        </ComboBox>
                    </StackPanel>

                    <Border Background="#1E293B" Padding="12" Margin="0,0,0,15" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource CurrentUserKey}" FontSize="11" Foreground="#64748B" 
                                       Margin="0,0,0,3"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" 
                                         Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtWorkerName" Text="admin" FontWeight="Bold" 
                                           Foreground="#38BDF8" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{DynamicResource MainSectionsKey}" FontSize="11" Foreground="#64748B" 
                                FontWeight="Bold" Margin="0,0,0,10"/>
                </StackPanel>

                <!-- Boutons de navigation -->
                <StackPanel Grid.Row="1">
                    <Button x:Name="BtnInventory" Content="{DynamicResource MenuInventory}" 
                            Background="Transparent" Foreground="#CBD5E1"
                            FontSize="13" FontWeight="SemiBold"
                            HorizontalContentAlignment="Left" Padding="15,12"
                            BorderThickness="0" Cursor="Hand"
                            Click="BtnShowInventory_Click" Margin="0,0,0,5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" Padding="10" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnSales" Content="{DynamicResource MenuSales}" 
                            Background="Transparent" Foreground="#CBD5E1"
                            FontSize="13" FontWeight="SemiBold"
                            HorizontalContentAlignment="Left" Padding="15,12"
                            BorderThickness="0" Cursor="Hand"
                            Click="BtnShowSales_Click" Margin="0,0,0,5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" Padding="10" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnAddProduct" Content="{DynamicResource MenuAddProduct}" 
                            Background="Transparent" Foreground="#CBD5E1"
                            FontSize="13" FontWeight="SemiBold"
                            HorizontalContentAlignment="Left" Padding="15,12"
                            BorderThickness="0" Cursor="Hand"
                            Click="BtnShowAddProduct_Click" Margin="0,0,0,5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" Padding="10" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnAddUser" Content="{DynamicResource MenuAddUser}" 
                            Background="Transparent" Foreground="#CBD5E1"
                            FontSize="13" FontWeight="SemiBold"
                            HorizontalContentAlignment="Left" Padding="15,12"
                            BorderThickness="0" Cursor="Hand"
                            Click="BtnShowAddUserWindow_Click" Margin="0,0,0,5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" Padding="10" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnLogs" Content="{DynamicResource MenuLogs}" 
                            Background="Transparent" Foreground="#CBD5E1"
                            FontSize="13" FontWeight="SemiBold"
                            HorizontalContentAlignment="Left" Padding="15,12"
                            BorderThickness="0" Cursor="Hand"
                            Click="BtnShowLogs_Click" Margin="0,0,0,5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" Padding="10" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnExpenses" Content="📊 Dépenses Mensuelles et Annuelles" 
                            Background="Transparent" Foreground="#CBD5E1"
                            FontSize="13" FontWeight="SemiBold"
                            HorizontalContentAlignment="Left" Padding="15,12"
                            BorderThickness="0" Cursor="Hand"
                            Click="BtnShowExpenses_Click" Margin="0,0,0,5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" Padding="10" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnNetProfit" Content="📈 Calcul des intérêts (Bénéfice net)" 
                            Background="Transparent" Foreground="#CBD5E1"
                            FontSize="13" FontWeight="SemiBold"
                            HorizontalContentAlignment="Left" Padding="15,12"
                            BorderThickness="0" Cursor="Hand"
                            Click="BtnShowNetProfit_Click" Margin="0,0,0,5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" Padding="10" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnSellersRevenue" Content="👥 Revenus par Vendeur" 
                            Background="Transparent" Foreground="#CBD5E1"
                            FontSize="13" FontWeight="SemiBold"
                            HorizontalContentAlignment="Left" Padding="15,12"
                            BorderThickness="0" Cursor="Hand"
                            Click="BtnShowSellersRevenue_Click" Margin="0,0,0,5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" Padding="10" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnSalesHistory" Content="📜 Historique des Ventes" 
                            Background="Transparent" Foreground="#CBD5E1"
                            FontSize="13" FontWeight="SemiBold"
                            HorizontalContentAlignment="Left" Padding="15,12"
                            BorderThickness="0" Cursor="Hand"
                            Click="BtnOpenSalesHistory_Click" Margin="0,0,0,5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" Padding="10" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnDamagedProducts" Content="🗑️ Produits Endommagés" 
        Background="Transparent" Foreground="#CBD5E1"
        FontSize="13" FontWeight="SemiBold"
        HorizontalContentAlignment="Left" Padding="15,12"
        BorderThickness="0" Cursor="Hand"
        Click="BtnShowDamagedProducts_Click" Margin="0,0,0,5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" Padding="10" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <Button Grid.Row="2" Content="{DynamicResource Logout}" 
                        Background="#EF4444" Foreground="White"
                        Height="45" Click="BtnLogout_Click" FontSize="14"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Zone de contenu -->
        <Border Grid.Column="1" Margin="25" Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
        
                <!-- Titre, barre de recherche et bouton d'impression d'inventaire -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <Grid>
                        <TextBlock x:Name="TxtPageTitle" Text="{DynamicResource InventoryManagementKey}" 
                                   FontSize="28" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center"/>

                        <!-- Bouton d'impression des produits sélectionnés pour l'inventaire -->
                        <Button Content="🖨️ Imprimer l'inventaire" Click="BtnPrintInventory_Click" 
                                Background="#8B5CF6" Foreground="White" Height="38" Width="170" 
                                HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                FontSize="13" FontWeight="Bold"/>
                    </Grid>

                    <Border Background="White" CornerRadius="10" Padding="10,8" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="SearchBox" Grid.Column="0" 
                                     FontSize="14" Padding="10,8"
                                     BorderThickness="1" BorderBrush="#CBD5E1" Background="#F1F5F9"
                                     TextChanged="SearchBox_TextChanged"/>

                            <Button Grid.Column="1" Content="{DynamicResource SearchBtn}" Width="90" Height="35"
                                    Background="#3B82F6" Foreground="White" 
                                    Click="SearchButton_Click" Margin="10,0"/>

                            <Button Grid.Column="2" Content="{DynamicResource RefreshBtn}" Width="90" Height="35"
                                    Background="#10B981" Foreground="White" 
                                    Click="RefreshButton_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Cartes de statistiques et de profits -->
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource DailyRevenueKey}" FontSize="12" Foreground="#64748B" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock x:Name="TxtDailyRevenue" Text="0.00" FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                                <TextBlock Text=" " FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                                <TextBlock Text="{DynamicResource CurrencyKey}" FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource MonthlyProfitKey}" FontSize="12" Foreground="#64748B" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock x:Name="TxtMonthlyProfit" Text="0.00" FontSize="20" FontWeight="Bold" Foreground="#3B82F6"/>
                                <TextBlock Text=" " FontSize="20" FontWeight="Bold" Foreground="#3B82F6"/>
                                <TextBlock Text="{DynamicResource CurrencyKey}" FontSize="20" FontWeight="Bold" Foreground="#3B82F6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Tableau des produits et calcul des intérêts -->
                <Border Grid.Row="2" Background="White" Padding="15" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>



                        <DataGrid x:Name="ProductsGrid" Grid.Row="0" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0" 
                                  RowHeight="45" FontSize="13" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0" SelectionChanged="ProductsGrid_SelectionChanged"
                                  MouseDoubleClick="ProductsGrid_MouseDoubleClick">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                    <Setter Property="Foreground" Value="#1E3A8A"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <!-- Alerte de stock faible -->
                                        <DataTrigger Binding="{Binding IsLowStock}" Value="1">
                                            <Setter Property="Background" Value="#FEF2F2"/>
                                        </DataTrigger>

                                        <!-- Alerte d'expiration ou d'expiration proche (moins d'un mois) -->
                                        <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                            <Setter Property="Background" Value="#FEE2E2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <!-- Colonne combinée : case de sélection globale dans l'en-tête et boutons individuels pour les lignes directement à côté de l'identifiant -->
                                <DataGridTemplateColumn Width="45">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <CheckBox x:Name="ChkSelectAll" Click="BtnSelectAllProductsForInventory_Click" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="BtnSelectProductForInventory_Click" Width="20" Height="20" Background="#E2E8F0" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="#CBD5E1" BorderThickness="1">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Colonne de l'identifiant (ID) -->
                                <DataGridTextColumn Header="{DynamicResource IdColumnKey}" Binding="{Binding Id}" Width="70"/>

                                <DataGridTextColumn Header="{DynamicResource BarcodeColumnKey}" Binding="{Binding Code}" Width="120"/>
                                <DataGridTextColumn Header="{DynamicResource ProductNameColumnKey}" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Date d'expiration" Binding="{Binding ExpiryDate}" Width="140"/>
                                <DataGridTextColumn Header="{DynamicResource PurchasePriceLabelKey}" Binding="{Binding PurchasePrice, StringFormat={}{0:N2}}" Width="110"/>
                                <DataGridTextColumn Header="{DynamicResource SellingPriceLabelKey}" Binding="{Binding SellingPrice, StringFormat={}{0:N2}}" Width="110"/>

                                <DataGridTextColumn Header="{DynamicResource QuantityLabelKey}" Binding="{Binding Quantity}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLowStock}" Value="1">
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="{DynamicResource MinQuantityColumnKey}" Binding="{Binding MinQuantity}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,15,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Total des produits au prix d'achat" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtTotalPurchaseStock" FontSize="18" FontWeight="Bold" Foreground="#EF4444" Margin="0,3,0,0">
                                        0.00 DA
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Total des produits au prix de vente" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtTotalSellingStock" FontSize="18" FontWeight="Bold" Foreground="#3B82F6" Margin="0,3,0,0">
                                        0.00 DA
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>