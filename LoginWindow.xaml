<Window x:Class="WarehouseApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion - Système de Gestion d'Entrepôt" Height="760" Width="1300"
        WindowStartupLocation="CenterScreen" FlowDirection="LeftToRight"
        Background="#F8FAFC" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Linear Gradients -->
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F172A" Offset="0"/>
            <GradientStop Color="#1E3A8A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#10B981" Offset="0"/>
            <GradientStop Color="#059669" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EF4444" Offset="0"/>
            <GradientStop Color="#DC2626" Offset="1"/>
        </LinearGradientBrush>

        <!-- Style Bouton 3D -->
        <Style x:Key="Btn3DPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="12" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource PrimaryGradient}">
                            <Border.Effect>
                                <DropShadowEffect Color="#1E40AF" BlurRadius="12" ShadowDepth="5" 
                                                  Direction="270" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#3B82F6" Offset="0"/>
                                            <GradientStop Color="#1D4ED8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#1E40AF" BlurRadius="18" ShadowDepth="8" 
                                                         Direction="270" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style PasswordBox 3D -->
        <Style x:Key="PasswordBox3D" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="3" 
                                                  Direction="270" Opacity="0.1"/>
                            </Border.Effect>
                            <Grid>
                                <Border x:Name="focusBorder" CornerRadius="10" BorderThickness="2" 
                                        BorderBrush="Transparent"/>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" Margin="5,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="focusBorder" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#2563EB" BlurRadius="12" ShadowDepth="4" 
                                                         Direction="270" Opacity="0.2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Barre Latérale -->
        <Style x:Key="Sidebar3D" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SidebarGradient}"/>
            <Setter Property="CornerRadius" Value="20,0,0,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="8" 
                                     Direction="270" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Carte -->
        <Style x:Key="Card3D" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="45,40"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#94A3B8" BlurRadius="20" ShadowDepth="6" 
                                     Direction="270" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- نموذج تسجيل الدخول (في اليسار) -->
        <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Style="{StaticResource Card3D}" Width="450">
                <StackPanel>
                    <TextBlock Text="Bienvenue de nouveau 👋" FontSize="24" FontWeight="Bold" 
                               Foreground="#1E3A8A" HorizontalAlignment="Center"/>
                    <TextBlock Text="Veuillez entrer le mot de passe pour accéder au système" FontSize="13" 
                               Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,30"/>

                    <TextBlock Text="Mot de passe" FontSize="13" Foreground="#475569" 
                               FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <PasswordBox x:Name="TxtPassword" Style="{StaticResource PasswordBox3D}" 
                                 KeyDown="TxtPassword_KeyDown" Loaded="TxtPassword_Loaded"/>

                    <Button Content="🚀 Connexion" Style="{StaticResource Btn3DPrimary}" 
                            Margin="0,25,0,0" Click="BtnLogin_Click" IsDefault="True" Height="50"/>

                    <TextBlock Text="  " FontSize="11" 
                               Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- الشريط الجانبي (في اليمين ليتناسب مع اتجاه LeftToRight) -->
        <Border Grid.Column="1" Style="{StaticResource Sidebar3D}">
            <Grid Margin="30">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📦" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="WAREHOUSE 3D" Foreground="#FFFFFF" FontSize="26" FontWeight="Bold" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Système de Gestion de Stock &amp; POS" Foreground="#93C5FD" FontSize="14" 
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <Border Height="2" Width="100" Background="#3B82F6" CornerRadius="2" 
                            Margin="0,20,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Version 3.0 - Professionnel" Foreground="#64748B" FontSize="11" 
                               HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>