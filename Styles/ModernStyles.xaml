<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================ -->
    <!--              الألوان الأساسية                 -->
    <!-- ============================================ -->
    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="PrimaryDark">#1D4ED8</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="BgColor">#F8FAFC</Color>
    <Color x:Key="CardBg">#FFFFFF</Color>
    <Color x:Key="TextPrimary">#1E293B</Color>
    <Color x:Key="TextSecondary">#64748B</Color>

    <!-- ============================================ -->
    <!--             التدرجات اللونية                  -->
    <!-- ============================================ -->
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3B82F6" Offset="0"/>
        <GradientStop Color="#2563EB" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#34D399" Offset="0"/>
        <GradientStop Color="#10B981" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F87171" Offset="0"/>
        <GradientStop Color="#EF4444" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WarningGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FBBF24" Offset="0"/>
        <GradientStop Color="#F59E0B" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0F172A" Offset="0"/>
        <GradientStop Color="#1E3A8A" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============================================ -->
    <!--           نمط الزر 3D الأساسي                 -->
    <!-- ============================================ -->
    <Style x:Key="Btn3DPrimary" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="border" CornerRadius="12" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource PrimaryGradient}">
                            <Border.Effect>
                                <DropShadowEffect Color="#1E40AF" BlurRadius="12" ShadowDepth="5" 
                                                 Direction="270" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="shine" CornerRadius="12" Opacity="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.5">
                                    <GradientStop Color="#4DFFFFFF" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3B82F6" Offset="0"/>
                                        <GradientStop Color="#1D4ED8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="shine" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#1E40AF" BlurRadius="18" ShadowDepth="8" 
                                                     Direction="270" Opacity="0.6"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#1E40AF" BlurRadius="6" ShadowDepth="2" 
                                                     Direction="270" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!--           نمط زر النجاح 3D                    -->
    <!-- ============================================ -->
    <Style x:Key="Btn3DSuccess" TargetType="Button" BasedOn="{StaticResource Btn3DPrimary}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" CornerRadius="12" Padding="{TemplateBinding Padding}"
                            Background="{StaticResource SuccessGradient}">
                        <Border.Effect>
                            <DropShadowEffect Color="#065F46" BlurRadius="12" ShadowDepth="5" 
                                             Direction="270" Opacity="0.4"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#34D399" Offset="0"/>
                                        <GradientStop Color="#059669" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#065F46" BlurRadius="18" ShadowDepth="8" 
                                                     Direction="270" Opacity="0.6"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!--           نمط زر الخطر 3D                     -->
    <!-- ============================================ -->
    <Style x:Key="Btn3DDanger" TargetType="Button" BasedOn="{StaticResource Btn3DPrimary}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" CornerRadius="12" Padding="{TemplateBinding Padding}"
                            Background="{StaticResource DangerGradient}">
                        <Border.Effect>
                            <DropShadowEffect Color="#991B1B" BlurRadius="12" ShadowDepth="5" 
                                             Direction="270" Opacity="0.4"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#991B1B" BlurRadius="18" ShadowDepth="8" 
                                                     Direction="270" Opacity="0.6"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!--           نمط زر التحذير 3D                   -->
    <!-- ============================================ -->
    <Style x:Key="Btn3DWarning" TargetType="Button" BasedOn="{StaticResource Btn3DPrimary}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" CornerRadius="12" Padding="{TemplateBinding Padding}"
                            Background="{StaticResource WarningGradient}">
                        <Border.Effect>
                            <DropShadowEffect Color="#92400E" BlurRadius="12" ShadowDepth="5" 
                                             Direction="270" Opacity="0.4"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#92400E" BlurRadius="18" ShadowDepth="8" 
                                                     Direction="270" Opacity="0.6"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!--           نمط حقل النص 3D                     -->
    <!-- ============================================ -->
    <Style x:Key="TextBox3D" TargetType="TextBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Background" Value="#F8FAFC"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="3" 
                                             Direction="270" Opacity="0.08"/>
                        </Border.Effect>
                        <Grid>
                            <Border x:Name="focusBorder" CornerRadius="10" BorderThickness="2" 
                                    BorderBrush="Transparent"/>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" Margin="5,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            <Setter TargetName="focusBorder" Property="BorderBrush" Value="#2563EB"/>
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#2563EB" BlurRadius="12" ShadowDepth="4" 
                                                     Direction="270" Opacity="0.15"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!--           نمط حقل كلمة المرور 3D              -->
    <!-- ============================================ -->
    <Style x:Key="PasswordBox3D" TargetType="PasswordBox">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Background" Value="#F8FAFC"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="3" 
                                             Direction="270" Opacity="0.1"/>
                        </Border.Effect>
                        <Grid>
                            <Border x:Name="focusBorder" CornerRadius="10" BorderThickness="2" 
                                    BorderBrush="Transparent"/>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" Margin="5,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            <Setter TargetName="focusBorder" Property="BorderBrush" Value="#2563EB"/>
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#2563EB" BlurRadius="12" ShadowDepth="4" 
                                                     Direction="270" Opacity="0.2"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!--           نمط البطاقة 3D                      -->
    <!-- ============================================ -->
    <Style x:Key="Card3D" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#94A3B8" BlurRadius="20" ShadowDepth="6" 
                                 Direction="270" Opacity="0.15"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!--           نمط الشريط الجانبي 3D               -->
    <!-- ============================================ -->
    <Style x:Key="Sidebar3D" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SidebarGradient}"/>
        <Setter Property="CornerRadius" Value="0,20,20,0"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="8" 
                                 Direction="270" Opacity="0.3"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!--           نمط زر الشريط الجانبي               -->
    <!-- ============================================ -->
    <Style x:Key="SidebarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#94A3B8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" 
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#334155"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>